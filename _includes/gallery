{% include base_path %}

{% if include.id %}
  {% assign gallery = page.[include.id] %}
{% else %}
  {% assign gallery = page.gallery %}
{% endif %}

{% if gallery.size == 2 %}
  {% assign gallery_layout = 'half' %}
{% elsif gallery.size >= 3 %}
  {% assign gallery_layout = 'third' %}
{% else %}
  {% assign gallery_layout = '' %}
{% endif %}

{% capture gallery_items %}{% for img in gallery %}{% if img.url %}<a href={% if img.url contains "://" %}"{{ img.url }}"{% else %}"{{ img.url | prepend: "/images/" | prepend: base_path }}"{% endif %}{% if img.title %} title="{{ img.title }}"{% endif %}><img src={% if img.image_path contains "://" %}"{{ img.image_path }}"{% else %}"{{ img.image_path | prepend: "/images/" | prepend: base_path }}"{% endif %} alt="{% if img.alt %}{{ img.alt }}{% endif %}"></a>{% else %}<img src={% if img.image_path contains "://" %}"{{ img.image_path }}"{% else %}"{{ img.image_path | prepend: "/images/" | prepend: base_path }}"{% endif %} alt="{% if img.alt %}{{ img.alt }}{% endif %}">{% endif %}{% endfor %}{% endcapture %}

{% if include.class contains 'scroll-gallery' %}
  {% assign scroll_duration = gallery.size | times: 3 | plus: 10 %}
<figure class="{{ include.class }}" style="--scroll-duration: {{ scroll_duration }}s;">
  <div class="scroll-track">
    <div class="scroll-group">{{ gallery_items }}</div>
    <div class="scroll-group" aria-hidden="true">{{ gallery_items }}</div>
  </div>
</figure>
{% else %}
<figure class="{{ gallery_layout }} {{ include.class }}">
  {{ gallery_items }}
  {% if include.caption %}
    <figcaption>{{ include.caption | markdownify | remove: "<p>" | remove: "</p>" }}</figcaption>
  {% endif %}
</figure>
{% endif %}
